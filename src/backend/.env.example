PORT=4000
# Comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgres://oj:oj@localhost:5432/online_judge
# Auto-create/alter tables from entities. Convenient for development; turn off in production.
DB_SYNC=true
# Optional: CA certificate file for hosted Postgres over SSL (Supabase: Settings > Database > SSL)
DATABASE_SSL_CA=
REDIS_URL=redis://localhost:6379

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# The single administrator account, created on first start if it does not exist.
ADMIN_EMAIL=admin@oj.local
ADMIN_PASSWORD=admin12345
ADMIN_NAME=Quản trị viên

# Max submissions per user waiting in the judge queue at the same time
MAX_PENDING_SUBMISSIONS=3

# Public URL of the frontend (used in teacher invitation links)
FRONTEND_URL=http://localhost:3000

# Email for OTP codes and invitations. Leave SMTP_HOST empty in development:
# emails are then printed to the server log instead of being sent.
# Gmail: enable 2-Step Verification, create an App Password (Google Account > Security > App passwords).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Online Judge <your.account@gmail.com>"

# Claude (AI exam reader, AI-usage check). Leave empty to disable AI features
# (the rule-based exam reader is used and AI-usage checks are skipped).
ANTHROPIC_API_KEY=
# Models per task (optional): exam reader, AI-usage review
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_REVIEW_MODEL=claude-haiku-5-5
