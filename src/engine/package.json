{
  "name": "@oj/engine",
  "version": "0.1.0",
  "private": true,
  "description": "Judge worker: consumes judge jobs from Redis, runs code in a sandbox, publishes results.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@oj/contracts": "workspace:*",
    "bullmq": "^6.5.1",
    "ioredis": "^6.0.0"
  },
  "devDependencies": {
    "tsx": "^4.23.15"
  }
}
